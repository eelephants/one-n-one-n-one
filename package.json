{
  "name": "one-n-one-n-one",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "lint": "npm -w apps/web run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm -w apps/web run typecheck",
    "db:types": "supabase gen types typescript --local > packages/domain/src/database.types.ts",
    "login-link": "node scripts/login-link.mjs",
    "seed-history": "node scripts/seed-history.mjs",
    "test:e2e": "playwright test",
    "check-key-leak": "node scripts/check-key-leak.mjs",
    "create-owner": "node scripts/create-owner.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:push:api": "node scripts/db-push-api.mjs",
    "setup-smtp": "node scripts/setup-smtp.mjs",
    "push-templates": "node scripts/push-templates.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.95.1",
    "supabase": "^2.60.7",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
